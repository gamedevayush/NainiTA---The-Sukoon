    { "op": "follow", "of": "car", "pos": [-1.45, 1.35, 0.9], "look": [0.15, 1.05, -0.5], "ease": "rigid", "wait": false, "fov": 46 },
    { "op": "say", "who": "mummy", "key": "Jis din milenge, us din pehchaan nahi paoge.", "en": "The day you meet Him, you won't recognise Him.", "hi": "जिस दिन मिलेंगे, उस दिन पहचान नहीं पाओगे।" },
    { "op": "follow", "of": "car", "pos": [0.02, 1.22, 0.25], "look": [0.48, 1.16, -0.73], "ease": "rigid", "wait": false, "fov": 44 },
