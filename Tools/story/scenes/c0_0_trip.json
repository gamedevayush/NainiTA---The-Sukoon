    { "op": "say", "who": "mummy", "key": "Pehle Naina Devi ke darshan, phir jheel mein naav.", "en": "First Naina Devi's darshan, then a boat on the lake.", "hi": "पहले नैना देवी के दर्शन, फिर झील में नाव।" },
    { "op": "follow", "of": "car", "pos": [0.02, 1.22, 0.25], "look": [0.48, 1.16, -0.73], "ease": "rigid", "wait": false, "fov": 46 },
