!Tools/newvehicles/models/*_dec.glb
Tools/newvehicles/models/*_settings.png
Tools/newvehicles/*.blend
!Tools/newvehicles/NewVehicles_v06.blend
!Tools/newvehicles/NewVehicles_v07.blend
*.blend1

